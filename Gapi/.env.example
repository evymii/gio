# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
# MongoDB Atlas connection string (Atlas → Connect → Drivers), with the database name before "?"
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/game?retryWrites=true&w=majority
# Secret for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long raw location history is kept (days). Older points are deleted automatically.
LOCATION_TTL_DAYS=7
# Comma-separated origins allowed by CORS ("*" = any; native iOS apps don't need CORS)
CORS_ORIGINS=*
# Seed data: centre of the demo campus. Defaults to the iOS Simulator's default location.
# SEED_LAT=37.3349
# SEED_LNG=-122.0090
# Password for the seeded demo accounts
SEED_PASSWORD=campus123
